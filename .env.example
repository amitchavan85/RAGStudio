CHUNKING_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
VECTOR_STORE=chroma
COLLECTION_NAME=rag_docs
QDRANT_URL=http://localhost:6333
PG_DSN=postgresql://postgres:postgres@localhost:5432/rag
LOG_LEVEL=INFO
LOG_DIR=./logs
LLM_MODEL=gpt-4o-mini
PDF_DIR=src/data/pdfs
RETRIEVAL_MODE=hybrid
RERANKER=none
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
# API
API_HOST=127.0.0.1
API_PORT=8000
# INDEXES={"production": {"vector_store": "qdrant", "embedding_provider": "openai"}}
ALLOW_CUSTOM_INDEX=false
# ALLOWED_CHUNKERS=["recursive","sentence","document","semantic"]
MAX_UPLOAD_MB=50
OCR=auto
# API_KEYS={"webapp": "change-me-long-random-key"}
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANSWERS_PER_MINUTE=30
# Models the ollama-pull job downloads into the Ollama container (space separated)
OLLAMA_MODELS=llama3.2:3b
